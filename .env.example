# Application
APP_NAME="KNEXUS API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# PostgreSQL + pgvector
POSTGRES_DB=knexus
POSTGRES_USER=knexus_admin
POSTGRES_PASSWORD=knexus_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://knexus_admin:knexus_password@localhost:5435/knexus
DATABASE_SYNC_URL=postgresql://knexus_admin:knexus_password@localhost:5435/knexus

# Ollama LLM Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Security & Authentication
SECRET_KEY=knexus-super-secret-development-key-change-in-production-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
