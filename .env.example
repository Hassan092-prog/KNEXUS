# Application
APP_NAME="KNEXUS API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# PostgreSQL + pgvector
POSTGRES_DB=knexus
POSTGRES_USER=knexus_admin
POSTGRES_PASSWORD=knexus_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://knexus_admin:knexus_password@localhost:5435/knexus
DATABASE_SYNC_URL=postgresql://knexus_admin:knexus_password@localhost:5435/knexus

# LLM provider (select one explicitly; fake is for tests only)
OLLAMA_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
GENERATION_MAX_PROMPT_CHARS=12000

# Embedding and ingestion
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=main
DOCUMENT_STORAGE_ROOT=.knexus-private-storage
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=1000
MAX_EXTRACTED_CHARS=5000000
CHUNK_TOKEN_LIMIT=240
CHUNK_TOKEN_OVERLAP=32
RETRIEVAL_MIN_SIMILARITY=0.35

# Security & Authentication
SECRET_KEY=knexus-super-secret-development-key-change-in-production-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
