# Frontend environment configuration.
# Copy to .env.local (never commit real backend URLs used to reach protected data).
# No API keys or provider secrets belong here — the backend owns all credentials.

# Base URL of the KNEXUS backend (no trailing slash).
# The dev server must run on http://localhost:5173 — that origin is whitelisted
# by the backend's BACKEND_CORS_ORIGINS (see backend/app/core/config.py).
VITE_API_BASE_URL=http://localhost:8000

# Optional Axios timeout override in milliseconds.
# VITE_API_TIMEOUT_MS=30000

# API mode: "mock" serves responses purely from local JSON fixtures under
# src/mocks/data/ with no network access. Defaults to "mock" when unset.
# "live" queries the KNEXUS backend. The active mode is always shown in the UI.
# There is no automatic mock fallback after a live failure — the active
# mode is always shown in the UI.

# Defaults to "mock" when unset. Set VITE_DATA_MODE=live to use the backend.
VITE_DATA_MODE=mock

# Artificial delay applied to mock-mode responses in milliseconds (exercise
# loading states). Ignored in live mode.
# VITE_MOCK_DELAY_MS=150
